<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AppLibertadoresHAS.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AppLibertadoresHAS"
    xmlns:partidas="clr-namespace:AppLibertadoresHAS.Views.Partidas"
    xmlns:usuarios="clr-namespace:AppLibertadoresHAS.Views.Usuarios"
    Title="AppLibertadoresHAS">
    
    <Shell.FlyoutHeaderTemplate>
        <DataTemplate>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{OnPlatform Android=130, iOS=200}"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                </Grid.RowDefinitions>
                <FlexLayout Grid.Row="0" Direction="Row" AlignItems="Center" >
                    <Border Padding="0" StrokeShape="RoundRectangle 40" StrokeThickness="0"         
HeightRequest="80" WidthRequest="80" >
                        <Image Source="has_logo_transparente_negativo.svg"/>
                    </Border>
                    <VerticalStackLayout Padding="10,0,0,0" Spacing="0">
                        <Label Text="App Libertadores HAS" FontAttributes="Bold" FontSize="Large"/>
                        <Label Text="Disciplina PAM-II"/>
                    </VerticalStackLayout>
                </FlexLayout>
            </Grid>
        </DataTemplate>
    </Shell.FlyoutHeaderTemplate>
    
    <ShellContent
        Title="Home" 
        ContentTemplate="{DataTemplate local:MainPage}" Icon="home.svg" Route="MainPage" />

    <ShellContent
        Title="Partidas" 
        ContentTemplate="{DataTemplate partidas:TabelaView}" Icon="menutabela.svg" Route="tabela" />
    
    <ShellContent 
        Title="Localização"
        ContentTemplate="{DataTemplate usuarios:LocalizacaoView}" Icon="menulocalizacao.svg" Route="usuarios" />
</Shell>

    
    